---
const year = new Date().getFullYear();
const links = [
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/elvis-s-296804153' },
	{ label: 'GitHub', href: 'https://github.com/elvissierra' },
];
---

<footer class="border-t border-line px-4 py-8 sm:px-6">
	<div class="mx-auto flex max-w-5xl flex-col gap-3 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
		<p>&copy; {year} Elvis Sierra</p>
		<ul class="flex gap-5">
			<li><a href="mailto:elvissierra3@gmail.com" class="hover:text-ink">Email</a></li>
			{links.map((link) => (
				<li>
					<a href={link.href} target="_blank" rel="noopener noreferrer" class="hover:text-ink">{link.label}</a>
				</li>
			))}
			<li><a href="/resume" class="hover:text-ink">Resume</a></li>
		</ul>
	</div>
</footer>
