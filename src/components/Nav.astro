---
const links = [
	{ href: '/#about', label: 'About' },
	{ href: '/#experience', label: 'Experience' },
	{ href: '/#projects', label: 'Projects' },
	{ href: '/resume', label: 'Resume' },
	{ href: '/#contact', label: 'Contact' },
];
---

<header class="fixed top-0 inset-x-0 z-50 border-b border-line bg-bg/85 backdrop-blur">
	<nav class="relative mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
		<a href="/" class="font-mono text-sm font-medium text-ink">
			elvis<span class="text-accent">.</span>sierra
		</a>
		<ul class="hidden items-center gap-7 text-sm md:flex">
			{links.map((link) => (
				<li>
					<a href={link.href} class="text-muted transition-colors hover:text-ink">{link.label}</a>
				</li>
			))}
		</ul>
		<details class="relative md:hidden" data-mobile-menu>
			<summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-line text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
				<span class="sr-only">Open navigation menu</span>
				<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5 stroke-current" stroke-width="1.8">
					<path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
				</svg>
			</summary>
			<div class="absolute right-0 top-[calc(100%+0.75rem)] w-[min(18rem,calc(100vw-2rem))] rounded-2xl border border-line bg-surface p-2 shadow-xl">
				<ul class="space-y-1 text-sm">
					{links.map((link) => (
						<li>
							<a href={link.href} class="block rounded-xl px-4 py-3 text-body hover:bg-accent-soft hover:text-ink focus-visible:outline-2 focus-visible:outline-accent">
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>
		</details>
	</nav>
</header>

<script>
	const mobileMenu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');

	mobileMenu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			mobileMenu.open = false;
		});
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && mobileMenu?.open) {
			mobileMenu.open = false;
			mobileMenu.querySelector('summary')?.focus();
		}
	});
</script>
